rules_version = '2';
// Luật CHUNG cho cả Đi Chùa Online và Countdown Online (cùng 1 Firebase project).
// Dán TOÀN BỘ file này vào Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Giá trị mới / cũ của một trường số (mặc định 0 nếu chưa có)
    function newVal(f) { return request.resource.data.get(f, 0); }
    function oldVal(f) { return resource == null ? 0 : resource.data.get(f, 0); }
    // Chỉ được tăng, và tăng tối đa `max` mỗi lần ghi (chống hack điểm cơ bản)
    function incOk(f, max) { return newVal(f) >= oldVal(f) && newVal(f) <= oldVal(f) + max; }

    function countersOk() {
      return incOk('congDuc', 10)
        && incOk('huong', 1) && incOk('cauPhuc', 1) && incOk('hoaSen', 1)
        && incOk('chuong', 1) && incOk('goMo', 1) && incOk('xinXam', 1);
    }

    function nameOk() {
      let n = request.resource.data.get('name', null);
      return n == null || (n is string && n.size() >= 1 && n.size() <= 24);
    }

    // Hồ sơ người chơi: ai đăng nhập cũng xem được (để hiện tên + bảng xếp hạng),
    // chỉ chủ nhân được sửa.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && newVal('congDuc') == 0 && nameOk();
      allow update: if isOwner(uid) && countersOk() && nameOk();
      allow delete: if false;

      // Lời cầu: riêng tư
      match /prayers/{pid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow update, delete: if false;
      }
    }

    // Tổng của cả chùa
    match /stats/global {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['congDuc', 'huong', 'cauPhuc', 'hoaSen', 'chuong', 'goMo', 'xinXam'])
        && countersOk();
    }

    // Dòng hoạt động
    match /events/{eid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'action', 'points', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.action in ['dangHuong', 'cauPhuc', 'hoaSen', 'chuong', 'goMo', 'xinXam']
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= 5
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }


    // =====================================================================
    // COUNTDOWN ONLINE — mỗi năm một mùa: cd_seasons/{y}/…
    // Mùa y = đếm ngược đến 00:00 01/01/y (giờ VN). Chỉ ghi được vào ĐÚNG mùa đang diễn ra;
    // mùa đã qua bị khoá (chỉ đọc). Mốc phải khớp js/time.js của countdown.
    // =====================================================================
    function tgt(y) { return timestamp.date(int(y), 1, 1) - duration.value(7, 'h'); }      // 00:00 01/01/y VN
    function dec1(y) { return timestamp.date(int(y) - 1, 12, 1) - duration.value(7, 'h'); } // 00:00 01/12/(y-1) VN
    function inSeason(y) { return request.time < tgt(y) && request.time >= tgt(int(y) - 1); }

    // Hệ số theo thời gian (giống timeMult trong time.js)
    function tMult(y) {
      return request.time >= tgt(y) ? 0
        : request.time >= tgt(y) - duration.value(60, 's') ? 10
        : request.time >= tgt(y) - duration.value(1, 'h') ? 5
        : request.time >= tgt(y) - duration.value(7, 'd') ? 3
        : request.time >= dec1(y) ? 2 : 1;
    }
    // Điểm tối đa cho 1 lần ghi = 1 phát pháo: hệ số thời gian × chuỗi (×2) × giờ vàng (×3)
    function cap(y) { return tMult(y) * 6; }
    function dlt(f) {
      return request.resource.data.get(f, 0) - (resource == null ? 0 : resource.data.get(f, 0));
    }
    function same(f) {
      return request.resource.data.get(f, null) == (resource == null ? null : resource.data.get(f, null));
    }
    // Mỗi người: 1 phát pháo / 15 giây (cho phép lệch mạng 1 giây → kiểm tra 14 giây)
    function cooldownOk() {
      return resource == null || !('lastAt' in resource.data)
        || request.time >= resource.data.lastAt + duration.value(14, 's');
    }

    function cdShotOk(y) {
      return request.resource.data.lastAt == request.time && cooldownOk()
        && dlt('total') >= 0 && dlt('total') <= cap(y)
        && same('streak') && same('lastCheckinAt') && same('lastWishAt');
    }
    function cdCheckinOk() {
      let prev = resource.data.get('lastCheckinAt', null);
      let s = request.resource.data.streak;
      return request.resource.data.lastCheckinAt == request.time
        && (prev == null || request.time >= prev + duration.value(20, 'h'))
        && (s == 1 || (prev != null && request.time < prev + duration.value(48, 'h') && s == resource.data.get('streak', 0) + 1))
        && dlt('total') >= 0 && dlt('total') <= 10 * s && s <= 1000
        && same('lastAt') && same('lastWishAt');
    }
    // Gửi lời chúc: mỗi người 1 lời chúc / 15 giây (ghi lastWishAt cùng lúc với lời chúc)
    function cdWishOk() {
      let prev = resource.data.get('lastWishAt', null);
      return request.resource.data.lastWishAt == request.time
        && (prev == null || request.time >= prev + duration.value(14, 's'))
        && dlt('total') == 0 && same('streak') && same('lastCheckinAt') && same('lastAt');
    }
    function cdProfileOnly() {
      return dlt('total') == 0 && same('streak') && same('lastCheckinAt') && same('lastAt') && same('lastWishAt');
    }
    function cdPeriodOk(y, uid) {
      return isOwner(uid) && inSeason(y)
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'pts', 'lastAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.lastAt == request.time && cooldownOk()
        && dlt('pts') >= 0 && dlt('pts') <= cap(y) + 300;
    }

    // Đọc: mọi dữ liệu countdown (kể cả các năm cũ) cho người đã đăng nhập
    match /cd_seasons/{y}/{document=**} {
      allow read: if signedIn();
    }
    match /cd_seasons/{y}/users/{uid} {
      allow create: if isOwner(uid) && inSeason(y)
        && request.resource.data.total == 0 && request.resource.data.streak == 0 && nameOk();
      allow update: if isOwner(uid) && inSeason(y) && nameOk()
        && (cdProfileOnly() || cdShotOk(y) || cdCheckinOk() || cdWishOk());
      allow delete: if false;
    }
    match /cd_seasons/{y}/days/{day}/players/{uid} {
      allow create, update: if cdPeriodOk(y, uid);
    }
    match /cd_seasons/{y}/weeks/{week}/players/{uid} {
      allow create, update: if cdPeriodOk(y, uid);
    }
    match /cd_seasons/{y}/wishes/{id} {
      allow create: if signedIn() && inSeason(y)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 120
        && request.resource.data.createdAt == request.time
        // phải ghi kèm lastWishAt trong hồ sơ (để máy chủ kiểm tra 15 giây)
        && getAfter(/databases/$(database)/documents/cd_seasons/$(y)/users/$(request.auth.uid)).data.lastWishAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
